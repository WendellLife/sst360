# Copie para .env e ajuste os valores.
# Desenvolvimento: DJANGO_DEBUG=True. Produção: DJANGO_DEBUG=False e uma chave própria com 50+ caracteres
# (gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"). Sem a chave, o sistema não sobe.
DJANGO_SECRET_KEY=troque-esta-chave-em-producao
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Produção atrás de HTTPS: o endereço completo, ex.: https://sst360.razach.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=
# Quem recebe por e-mail os erros 500 (separe por vírgula)
DJANGO_ADMINS=
# HSTS: tempo em segundos e se vale para os subdomínios (ligue só se todos usam HTTPS)
DJANGO_HSTS_SECONDS=2592000
DJANGO_HSTS_SUBDOMINIOS=False

# Postgres via docker-compose. Para rodar sem Docker, use:
# DATABASE_URL=sqlite:///db.sqlite3
DATABASE_URL=postgres://sst360:sst360@localhost:5433/sst360

TIME_ZONE=America/Sao_Paulo

# Em producao, rode collectstatic e ligue o manifesto de arquivos estaticos
DJANGO_STATIC_MANIFEST=False

# Canal do codigo de acesso do portal: email ou nenhum
CANAL_CODIGO_ACESSO=email

# WhatsApp da consultoria (so digitos, com DDI) para o botao do diagnostico
WHATSAPP_NUMERO=5511916714922

# Endereco publico do sistema (usado nos links dos e-mails)
SITE_URL=http://localhost:8000

# E-mail. Deixe EMAIL_HOST vazio para as mensagens sairem no terminal.
# Campanhas (e-mail marketing): use um servico de disparo, nao uma caixa comum.
# Brevo: EMAIL_HOST=smtp-relay.brevo.com, EMAIL_PORT=587, EMAIL_HOST_USER=<login SMTP>,
# EMAIL_HOST_PASSWORD=<chave SMTP>. Autentique o dominio (SPF, DKIM e DMARC) no painel do Brevo
# e use um remetente desse dominio em DEFAULT_FROM_EMAIL, senao as mensagens caem no spam.
# SITE_URL precisa ser o endereco publico: e por ele que saem os links de cotacao e descadastro.
# Envio mensal (dia 1o, 9h), no cron do servidor:
#   0 9 1 * *  cd /caminho/sst360 && python manage.py regua_mensal --enviar
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=SST360 <nao-responda@suaempresa.com.br>
# Quem recebe os avisos de prazos sem responsavel definido (separe por virgula)
NOTIFICACOES_SUPERVISAO=

# Sistema Tarefas (Razach Tarefas Internas): o SST360 lê clientes, tarefas, projetos e turmas,
# somente leitura, para a área comercial. Use um usuário do banco só com SELECT.
# TAREFAS_DATABASE_URL=postgres://leitura:senha@servidor:5432/razach_tarefas
# TAREFAS_URL=https://tarefas.seu-dominio.com.br
